10 TEXT:HOME
20 PRINT "IP SETUP":PRINT
30 INPUT "IP (192.168.64.1): ";I$
40 IF I$="" THEN I$="192.168.64.1"
50 P=1:N=0:A=0:B=0:C=0:D=0
60 FOR J=1 TO LEN(I$):X$=MID$(I$,J,1)
70 IF X$="." THEN GOSUB 200:P=P+1:N=0:GOTO 90
80 N=N*10+VAL(X$)
90 NEXT J:GOSUB 200
100 POKE 768,A:POKE 769,B:POKE 770,C:POKE 771,D:POKE 772,162
110 PRINT "SET: ";A;".";B;".";C;".";D:END
200 IF P=1 THEN A=N
210 IF P=2 THEN B=N
220 IF P=3 THEN C=N
230 IF P=4 THEN D=N
240 RETURN
