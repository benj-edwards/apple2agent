10 HGR : POKE 232,0: POKE 233,3
20 FOR I = 0 TO 13: READ V: POKE 768 + I,V: NEXT
30 DATA 1,0,4,0,27,45,45,29,27,18,36,36,4,0
40 DIM C$(5),CV(5): FOR I = 0 TO 5: READ CV(I),C$(I): NEXT
50 DATA 3,WHITE,1,GREEN,2,VIOLET,5,ORANGE,6,BLUE,0,BLACK (ERASER)
60 SCALE= 1: ROT= 0:X = 140:Y = 80:P = 0:CI = 0: HCOLOR= CV(CI)
70 GOSUB 500: XDRAW 1 AT X,Y
100 K = PEEK ( - 16384): IF K < 128 THEN 100
110 POKE - 16368,0:K = K - 128: IF K > 96 THEN K = K - 32
120 IF K = 27 THEN TEXT : HOME : &
130 NX = X:NY = Y
140 IF K = 8 THEN NX = X - 1
150 IF K = 21 THEN NX = X + 1
160 IF K = 11 THEN NY = Y - 1
170 IF K = 10 OR K = 13 THEN NY = Y + 1
180 IF NX < 2 THEN NX = 2
185 IF NX > 277 THEN NX = 277
190 IF NY < 2 THEN NY = 2
195 IF NY > 157 THEN NY = 157
200 IF K = 32 THEN P = 1 - P: GOSUB 500: IF P THEN HPLOT X,Y
210 IF K = 67 THEN CI = CI + 1: IF CI > 5 THEN CI = 0
215 IF K = 67 THEN HCOLOR= CV(CI): GOSUB 500
220 IF K = 69 THEN HGR : GOSUB 500: XDRAW 1 AT X,Y
230 IF NX = X AND NY = Y THEN 100
240 XDRAW 1 AT X,Y: IF P THEN HPLOT X,Y TO NX,NY
250 X = NX:Y = NY: XDRAW 1 AT X,Y: GOTO 100
500 HOME : VTAB 21: PRINT "PEN: ";: IF P THEN PRINT "DOWN";
510 IF NOT P THEN PRINT "UP  ";
520 PRINT "   COLOR: ";C$(CI)
530 PRINT "ARROWS MOVE  SPACE PEN  C COLOR"
540 PRINT "E ERASE ALL  ESC QUIT";: RETURN
