1 REM === DUNGEON OF DOOM ===
2 REM A DIKUMUD-STYLE RPG FOR APPLE II
3 REM
5 DIM RN$(25),RD$(25),RE(25,4)
6 DIM MN$(8),MH(8),MA(8),MD(8),MX(8),MG(8),ML(8)
7 DIM RM(25),MR(25)
8 DIM WN$(6),WA(6),WC(6)
9 DIM AN$(4),AD(4),AC(4)
10 DIM SN$(3),SD(3),SC(3)
11 DIM LV(5)
12 GOTO 1400
15 REM === MAIN LOOP ===
100 REM -- DISPLAY ROOM --
101 HOME
102 INVERSE : PRINT " ";RN$(CR);" "; : NORMAL : PRINT
103 PRINT RD$(CR)
104 PRINT
105 REM -- SHOW EXITS
106 EX$ = ""
107 IF RE(CR,1) > 0 THEN EX$ = EX$ + "N "
108 IF RE(CR,2) > 0 THEN EX$ = EX$ + "S "
109 IF RE(CR,3) > 0 THEN EX$ = EX$ + "E "
110 IF RE(CR,4) > 0 THEN EX$ = EX$ + "W "
111 PRINT "EXITS: ";EX$
112 REM -- SHOW MONSTER IF PRESENT
113 IF RM(CR) > 0 THEN PRINT "A ";MN$(RM(CR));" IS HERE!"
114 REM -- STATUS BAR
115 PRINT
116 INVERSE
117 PRINT "HP:";HP;"/";MX;" LV:";LV;" GP:";GP;" XP:";XP;
118 IF WE > 0 THEN PRINT " W:";WN$(WE);
119 NORMAL : PRINT
120 PRINT
130 REM -- GET COMMAND
131 PRINT "> ";
132 INPUT "";CM$
133 IF LEN(CM$) = 0 THEN 100
134 C$ = LEFT$(CM$,1)
135 REM -- MOVEMENT
136 IF C$ = "N" THEN DR = 1: GOTO 200
137 IF C$ = "S" THEN DR = 2: GOTO 200
138 IF C$ = "E" THEN DR = 3: GOTO 200
139 IF C$ = "W" THEN DR = 4: GOTO 200
140 REM -- ACTIONS
141 IF C$ = "L" THEN GOTO 300
142 IF C$ = "A" OR C$ = "K" OR C$ = "F" THEN GOTO 500
143 IF C$ = "I" THEN GOTO 600
144 IF C$ = "B" THEN GOTO 400
145 IF C$ = "R" THEN GOTO 800
146 IF C$ = "Q" THEN GOTO 700
147 IF C$ = "H" THEN GOTO 160
148 IF C$ = "?" THEN GOTO 160
149 PRINT "WHAT? (H FOR HELP)"
150 GOTO 130
160 REM -- HELP
161 PRINT "N/S/E/W - MOVE"
162 PRINT "A/K/F   - ATTACK"
163 PRINT "L       - LOOK"
164 PRINT "I       - INVENTORY"
165 PRINT "B       - BUY (IN SHOP)"
166 PRINT "R       - REST (INN/TEMPLE)"
167 PRINT "Q       - QUIT"
168 PRINT : PRINT "PRESS ANY KEY";
169 GET K$: GOTO 100
200 REM === MOVEMENT ===
201 NR = RE(CR,DR)
202 IF NR = 0 THEN PRINT "YOU CAN'T GO THAT WAY.": GOTO 130
203 REM -- MONSTER BLOCKS EXIT?
204 IF RM(CR) > 0 THEN PRINT "THE ";MN$(RM(CR));" BLOCKS YOUR PATH!": GOTO 130
205 CR = NR
206 MV = MV + 1
207 REM -- RESPAWN CHECK
208 IF MV - LS >= RS THEN GOSUB 850
209 REM -- VAULT WIN CHECK
210 IF CR = 21 THEN GOTO 1500
211 GOTO 100
300 REM === LOOK ===
301 PRINT
302 PRINT RD$(CR)
303 IF RM(CR) > 0 THEN PRINT : PRINT "A ";MN$(RM(CR));" LURKS HERE."
304 GOTO 130
400 REM === SHOP ===
401 IF CR <> 2 THEN PRINT "NO SHOP HERE.": GOTO 130
402 HOME
403 PRINT "=== OLDE SHOPPE ==="
404 PRINT "YOUR GOLD: ";GP
405 PRINT
406 PRINT "WEAPONS:"
407 FOR I = 1 TO 6
408 IF I > WE THEN PRINT I;". ";WN$(I);" (+";WA(I);") - ";WC(I);"G"
409 NEXT I
410 PRINT : PRINT "ARMOR:"
411 FOR I = 1 TO 4
412 IF I > AR THEN PRINT I + 6;". ";AN$(I);" (+";AD(I);") - ";AC(I);"G"
413 NEXT I
414 PRINT : PRINT "SHIELDS:"
415 FOR I = 1 TO 3
416 IF I > SH THEN PRINT I + 10;". ";SN$(I);" (+";SD(I);") - ";SC(I);"G"
417 NEXT I
418 PRINT : PRINT "0. LEAVE"
419 INPUT "BUY WHICH? ";BU
420 IF BU = 0 THEN 100
421 IF BU >= 1 AND BU <= 6 THEN GOTO 430
422 IF BU >= 7 AND BU <= 10 THEN GOTO 440
423 IF BU >= 11 AND BU <= 13 THEN GOTO 450
424 GOTO 400
430 REM -- BUY WEAPON
431 IF BU <= WE THEN PRINT "YOU HAVE THAT.": GOTO 460
432 IF GP < WC(BU) THEN PRINT "NOT ENOUGH GOLD!": GOTO 460
433 GP = GP - WC(BU): WE = BU
434 PRINT "BOUGHT ";WN$(BU);"!"
435 GOTO 460
440 REM -- BUY ARMOR
441 AI = BU - 6
442 IF AI <= AR THEN PRINT "YOU HAVE THAT.": GOTO 460
443 IF GP < AC(AI) THEN PRINT "NOT ENOUGH GOLD!": GOTO 460
444 GP = GP - AC(AI): AR = AI
445 PRINT "BOUGHT ";AN$(AI);"!"
446 GOTO 460
450 REM -- BUY SHIELD
451 SI = BU - 10
452 IF SI <= SH THEN PRINT "YOU HAVE THAT.": GOTO 460
453 IF GP < SC(SI) THEN PRINT "NOT ENOUGH GOLD!": GOTO 460
454 GP = GP - SC(SI): SH = SI
455 PRINT "BOUGHT ";SN$(SI);"!"
460 PRINT : PRINT "PRESS ANY KEY";
461 GET K$: GOTO 400
500 REM === COMBAT ===
501 IF RM(CR) = 0 THEN PRINT "NOTHING TO FIGHT!": GOTO 130
502 MI = RM(CR)
503 EH = MH(MI): REM ENEMY HP
504 EN$ = MN$(MI)
505 EA = MA(MI): REM ENEMY ATK
506 EF = MD(MI): REM ENEMY DEF
507 PRINT
508 PRINT "=== COMBAT: ";EN$;" ==="
510 REM -- COMBAT LOOP
511 IF EH <= 0 THEN GOTO 560
512 IF HP <= 0 THEN GOTO 700
513 REM -- PLAYER ATTACKS
514 PA = BA + WA(WE) + INT(RND(1) * (BA + WA(WE)) / 2)
515 REM -- CRITICAL HIT 5%
516 CR$ = ""
517 IF RND(1) < 0.05 THEN PA = PA * 2: CR$ = " *CRITICAL*"
518 DM = PA - EF
519 IF DM < 1 THEN DM = 1
520 EH = EH - DM
521 PRINT "YOU HIT ";EN$;" FOR ";DM;CR$
522 IF EH <= 0 THEN GOTO 560
523 REM -- MONSTER FLEES AT <25% HP?
524 IF EH < MH(MI) / 4 THEN IF RND(1) < 0.3 THEN PRINT EN$;" FLEES!": RM(CR) = 0: GOTO 130
525 REM -- ENEMY ATTACKS
526 ED = AD(AR) + SD(SH)
527 EA2 = EA + INT(RND(1) * EA / 2)
528 DM = EA2 - ED
529 IF DM < 1 THEN DM = 1
530 HP = HP - DM
531 PRINT EN$;" HITS YOU FOR ";DM;" (HP:";HP;")"
532 GOTO 510
560 REM -- VICTORY
561 PRINT
562 PRINT EN$;" IS DEFEATED!"
563 RM(CR) = 0
564 REM -- GOLD DROP
565 GD = MG(MI) + INT(RND(1) * MG(MI))
566 GP = GP + GD
567 PRINT "YOU FIND ";GD;" GOLD."
568 REM -- XP
569 XP = XP + MX(MI)
570 PRINT "YOU GAIN ";MX(MI);" XP."
571 REM -- CHECK LEVEL UP
572 GOSUB 650
573 REM -- EQUIPMENT DROP (20% CHANCE)
574 IF RND(1) < 0.2 THEN GOSUB 900
575 REM -- DRAGON SPECIAL
576 IF MI = 8 THEN DK = 1: PRINT : PRINT "THE DRAGON IS SLAIN!"
577 PRINT : PRINT "PRESS ANY KEY";
578 GET K$: GOTO 100
600 REM === INVENTORY ===
601 HOME
602 PRINT "=== INVENTORY ==="
603 PRINT
604 PRINT "LEVEL: ";LV;"  XP: ";XP
605 PRINT "HP: ";HP;"/";MX
606 PRINT "BASE ATTACK: ";BA
607 PRINT "GOLD: ";GP
608 PRINT
609 IF WE > 0 THEN PRINT "WEAPON: ";WN$(WE);" (+";WA(WE);")"
610 IF WE = 0 THEN PRINT "WEAPON: FISTS (+0)"
611 IF AR > 0 THEN PRINT "ARMOR:  ";AN$(AR);" (+";AD(AR);")"
612 IF AR = 0 THEN PRINT "ARMOR:  NONE"
613 IF SH > 0 THEN PRINT "SHIELD: ";SN$(SH);" (+";SD(SH);")"
614 IF SH = 0 THEN PRINT "SHIELD: NONE"
615 PRINT
616 PRINT "TOTAL ATK: ";BA + WA(WE)
617 PRINT "TOTAL DEF: ";AD(AR) + SD(SH)
618 IF DK = 1 THEN PRINT : PRINT "* DRAGON SLAYER *"
619 PRINT : PRINT "PRESS ANY KEY";
620 GET K$: GOTO 100
650 REM === LEVEL UP CHECK ===
651 FOR LI = 5 TO 1 STEP -1
652 IF XP >= LV(LI) AND LV < LI THEN GOTO 660
653 NEXT LI
654 RETURN
660 LV = LI
661 MX = 25 + (LV - 1) * 5
662 HP = MX: REM FULL HEAL ON LEVEL UP
663 BA = 3 + LV
664 PRINT
665 INVERSE : PRINT " LEVEL UP! YOU ARE NOW LEVEL ";LV;" ": NORMAL
666 PRINT "MAX HP: ";MX;" ATK: ";BA
667 RETURN
700 REM === DEATH / GAME OVER ===
701 HOME
702 PRINT
703 PRINT "================================"
704 PRINT "        YOU HAVE DIED"
705 PRINT "================================"
706 PRINT
707 PRINT "LEVEL: ";LV
708 PRINT "XP: ";XP
709 PRINT "GOLD: ";GP
710 PRINT "MOVES: ";MV
711 PRINT
712 INPUT "PLAY AGAIN? (Y/N) ";PA$
713 IF LEFT$(PA$,1) = "Y" THEN GOTO 1400
714 HOME : END
750 REM === WIN CONDITION ===
751 HOME
752 PRINT
753 PRINT "================================"
754 PRINT "     *** VICTORY! ***"
755 PRINT "================================"
756 PRINT
757 PRINT "YOU FOUND THE DRAGON'S HOARD!"
758 PRINT "MOUNTAINS OF GOLD AND JEWELS"
759 PRINT "GLITTER IN THE TORCHLIGHT."
760 PRINT
761 PRINT "YOU ARE THE CHAMPION OF THE"
762 PRINT "DUNGEON OF DOOM!"
763 PRINT
764 PRINT "LEVEL: ";LV
765 PRINT "XP: ";XP
766 PRINT "GOLD: ";GP
767 PRINT "MOVES: ";MV
768 PRINT
769 INPUT "PLAY AGAIN? (Y/N) ";PA$
770 IF LEFT$(PA$,1) = "Y" THEN GOTO 1400
771 HOME : END
800 REM === REST (INN/TEMPLE) ===
801 IF CR = 3 THEN GOTO 810
802 IF CR = 4 THEN GOTO 830
803 PRINT "NOWHERE TO REST HERE."
804 GOTO 130
810 REM -- INN (5 GOLD)
811 IF GP < 5 THEN PRINT "YOU NEED 5 GOLD.": GOTO 130
812 GP = GP - 5
813 HP = MX
814 PRINT "YOU REST AT THE INN."
815 PRINT "HP RESTORED TO ";MX;"!"
816 GOTO 130
830 REM -- TEMPLE (15 GOLD, FULL HEAL)
831 IF GP < 15 THEN PRINT "THE TEMPLE ASKS 15 GOLD.": GOTO 130
832 GP = GP - 15
833 HP = MX
834 PRINT "THE PRIESTS HEAL YOUR WOUNDS."
835 PRINT "HP RESTORED TO ";MX;"!"
836 GOTO 130
850 REM === RESPAWN MONSTERS ===
851 LS = MV: REM RESET LAST SPAWN COUNTER
852 FOR I = 1 TO 25
853 IF MR(I) > 0 AND RM(I) = 0 THEN RM(I) = MR(I)
854 NEXT I
855 REM -- DRAGON NEVER RESPAWNS
856 IF DK = 1 THEN RM(20) = 0
857 RETURN
900 REM === LOOT DROP ===
901 MI2 = RM(CR): IF MI2 = 0 THEN MI2 = MI
902 DL = ML(MI2)
903 IF DL = 0 THEN RETURN
904 REM -- DL ENCODES DROP: 1-6=WEAPON, 7-10=ARMOR, 11-13=SHIELD
905 IF DL >= 1 AND DL <= 6 THEN GOTO 910
906 IF DL >= 7 AND DL <= 10 THEN GOTO 920
907 IF DL >= 11 AND DL <= 13 THEN GOTO 930
908 RETURN
910 REM -- WEAPON DROP
911 IF DL > WE THEN WE = DL: PRINT "YOU FOUND: ";WN$(DL);"!"
912 RETURN
920 REM -- ARMOR DROP
921 AI = DL - 6
922 IF AI > AR THEN AR = AI: PRINT "YOU FOUND: ";AN$(AI);"!"
923 RETURN
930 REM -- SHIELD DROP
931 SI = DL - 10
932 IF SI > SH THEN SH = SI: PRINT "YOU FOUND: ";SN$(SI);"!"
933 RETURN
1000 REM ========================
1001 REM === ROOM DATA ===
1002 REM NAME, DESC, N,S,E,W
1003 REM ========================
1004 REM -- TOWN (ROOMS 1-5)
1005 DATA "TOWN SQUARE","A BUSTLING SQUARE WITH A FOUNTAIN.",2,5,3,4
1006 DATA "OLDE SHOPPE","WEAPONS AND ARMOR LINE THE WALLS.",0,1,0,0
1007 DATA "WEARY INN","A WARM FIRE CRACKLES. REST 5G.",0,0,0,1
1008 DATA "SACRED TEMPLE","HOLY LIGHT FILLS THIS PLACE. HEAL 15G.",0,0,1,0
1009 DATA "TOWN GATE","THE ROAD LEADS INTO DARK FOREST.",1,0,6,0
1010 REM -- FOREST (ROOMS 6-12)
1011 DATA "FOREST PATH","TALL TREES BLOCK THE SUNLIGHT.",0,0,7,5
1012 DATA "DARK CLEARING","A CIRCLE OF DEAD TREES. BONES LITTER THE GROUND.",8,0,0,6
1013 DATA "MOSSY STREAM","CLEAR WATER BABBLES OVER STONES.",0,7,9,0
1014 DATA "THICK THICKET","THORNY BUSHES TEAR AT YOUR CLOTHES.",0,0,10,8
1015 DATA "MOONLIT GLADE","STRANGE MUSHROOMS GLOW FAINTLY.",0,9,0,0
1016 DATA "GLOOMY GLADE","OWLS HOOT FROM TWISTED BRANCHES.",12,6,0,0
1017 DATA "CAVE MOUTH","A DARK CAVE YAWNS BEFORE YOU.",0,11,13,0
1018 REM -- DUNGEON (ROOMS 13-20)
1019 DATA "DUNGEON ENTRY","DAMP STONE WALLS DRIP WITH SLIME.",14,0,0,12
1020 DATA "GREAT HALL","PILLARS HOLD UP A VAULTED CEILING.",0,13,15,16
1021 DATA "PRISON CELLS","RUSTED CHAINS HANG FROM THE WALLS.",0,0,17,14
