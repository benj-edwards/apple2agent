1025 DATA "BOTTOMLESS PIT","A CHASM YAWNS BELOW A NARROW BRIDGE.",20,0,0,18
1026 DATA "BOSS CHAMBER","SCORCH MARKS COVER EVERY SURFACE.",0,19,21,0
1027 REM -- EXTRA ROOMS
1028 DATA "DRAGON'S VAULT","PILES OF GOLD GLITTER.",0,0,0,20
1029 REM ROOMS 22-25 UNUSED
1030 DATA "VOID","EMPTY",0,0,0,0
1031 DATA "VOID","EMPTY",0,0,0,0
1032 DATA "VOID","EMPTY",0,0,0,0
1033 DATA "VOID","EMPTY",0,0,0,0
1100 REM ========================
1101 REM === MONSTER DATA ===
1102 REM NAME, HP, ATK, DEF, XP, GOLD, DROP
1103 REM ========================
1104 DATA "SEWER RAT",8,2,0,5,3,0
1105 DATA "GOBLIN",15,4,1,12,8,1
1106 DATA "WOLF",20,6,1,18,5,0
1107 DATA "SKELETON",25,8,2,25,12,2
1108 DATA "ORC WARRIOR",30,9,3,32,15,7
1109 DATA "ORC CAPTAIN",35,10,4,40,20,8
1110 DATA "DARK MAGE",28,12,2,45,25,11
1111 DATA "ANCIENT DRAGON",60,15,5,100,50,4
1200 REM ========================
1201 REM === WEAPON DATA ===
1202 REM NAME, ATK BONUS, COST
1203 REM ========================
1204 DATA "DAGGER",2,10
1205 DATA "SHORT SWORD",4,25
1206 DATA "LONG SWORD",6,50
1207 DATA "BATTLE AXE",8,80
1208 DATA "MAGIC BLADE",11,150
1209 DATA "DRAGONBANE",14,0
1250 REM === ARMOR DATA ===
1251 DATA "LEATHER",2,15
1252 DATA "CHAIN MAIL",4,40
1253 DATA "PLATE MAIL",7,100
1254 DATA "MITHRIL MAIL",10,250
1300 REM === SHIELD DATA ===
1301 DATA "BUCKLER",1,10
1302 DATA "KITE SHIELD",3,30
1303 DATA "TOWER SHIELD",5,75
1350 REM === LEVEL THRESHOLDS ===
1351 DATA 0,50,150,350,700
1400 REM ========================
1401 REM === INITIALIZATION ===
1402 REM ========================
1403 HOME
1404 PRINT
1405 PRINT "  =========================="
1406 PRINT "    DUNGEON OF DOOM"
1407 PRINT "    A DIKUMUD-STYLE RPG"
1408 PRINT "  =========================="
1409 PRINT
1410 PRINT "  EXPLORE 20 ROOMS"
1411 PRINT "  FIGHT 8 MONSTER TYPES"
1412 PRINT "  SLAY THE DRAGON!"
1413 PRINT
1414 PRINT "  PRESS ANY KEY TO BEGIN"
1415 GET K$
1416 REM -- READ ROOM DATA
1417 RESTORE
1418 FOR I = 1 TO 25
1419 READ RN$(I),RD$(I),RE(I,1),RE(I,2),RE(I,3),RE(I,4)
1420 NEXT I
1421 REM -- READ MONSTER DATA
1422 FOR I = 1 TO 8
1423 READ MN$(I),MH(I),MA(I),MD(I),MX(I),MG(I),ML(I)
1424 NEXT I
1425 REM -- READ WEAPON DATA
1426 FOR I = 1 TO 6
1427 READ WN$(I),WA(I),WC(I)
1428 NEXT I
1429 REM -- READ ARMOR DATA
1430 FOR I = 1 TO 4
1431 READ AN$(I),AD(I),AC(I)
1432 NEXT I
1433 REM -- READ SHIELD DATA
1434 FOR I = 1 TO 3
1435 READ SN$(I),SD(I),SC(I)
1436 NEXT I
1437 REM -- READ LEVEL THRESHOLDS
1438 FOR I = 1 TO 5
1439 READ LV(I)
1440 NEXT I
1441 REM -- PLACE MONSTERS IN ROOMS
1442 REM TOWN: RAT IN GATE
1443 RM(5) = 1: MR(5) = 1
1444 REM FOREST: GOBLINS AND WOLVES
1445 RM(6) = 2: MR(6) = 2
1446 RM(7) = 3: MR(7) = 3
1447 RM(9) = 2: MR(9) = 2
1448 RM(10) = 3: MR(10) = 3
1449 RM(11) = 2: MR(11) = 2
1450 RM(12) = 3: MR(12) = 3
1451 REM DUNGEON: SKELETONS, ORCS, MAGE
1452 RM(13) = 4: MR(13) = 4
1453 RM(14) = 5: MR(14) = 5
1454 RM(15) = 4: MR(15) = 4
1455 RM(16) = 5: MR(16) = 5
1456 RM(17) = 6: MR(17) = 6
1457 RM(18) = 6: MR(18) = 6
1458 RM(19) = 7: MR(19) = 7
1459 REM BOSS CHAMBER: DRAGON
1460 RM(20) = 8: MR(20) = 8
1461 REM -- PLAYER STATS
1462 HP = 25: MX = 25
1463 LV = 1: XP = 0: GP = 15
1464 BA = 4: REM BASE ATTACK
1465 WE = 0: AR = 0: SH = 0: REM NO EQUIPMENT
1466 DK = 0: REM DRAGON NOT KILLED
1467 CR = 1: REM START IN TOWN SQUARE
1468 MV = 0: LS = 0: RS = 15: REM RESPAWN EVERY 15 MOVES
1469 REM -- CHECK FOR VAULT WIN
1470 REM (ENTERING ROOM 21 WITH DRAGON DEAD)
1471 GOTO 100
1500 REM === VAULT CHECK ===
1501 REM CALLED WHEN ENTERING ROOM 21
1502 IF DK = 1 THEN GOTO 750
1503 PRINT "THE VAULT IS SEALED."
1504 PRINT "THE DRAGON MUST BE SLAIN FIRST."
1505 GOTO 130
